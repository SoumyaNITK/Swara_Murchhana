<!DOCTYPE html>
<html lang="or">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= song.Name || slug %> • ସ୍ୱର ମୂର୍ଚ୍ଛନା</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Oriya:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #070709;
      --surface: #0f0f14;
      --surface-2: #16161f;
      --border: rgba(255, 255, 255, 0.15);
      --border-subtle: rgba(255, 255, 255, 0.09);
      --border-accent: rgba(246, 178, 68, 0.55);
      --accent: #f6b244;
      --accent-soft: #ffe09e;
      --accent-glow: rgba(246, 178, 68, 0.15);
      --text: #f7f7fb;
      --muted: #8f8fa3;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: #232330; border-radius: 999px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(246, 178, 68, 0.5); }

    body {
      font-family: 'Plus Jakarta Sans', 'Noto Sans Oriya', sans-serif;
      background-color: var(--bg);
      background-image:
        radial-gradient(ellipse 80% 38% at 50% -6%, rgba(246, 178, 68, 0.16), transparent 72%),
        radial-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px);
      background-size: 100% 100%, 26px 26px;
      color: var(--text);
      min-height: 100vh;
      padding: 36px 20px 96px;
    }

    .stage { max-width: 780px; margin: auto; }

    .nav-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 26px;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #d6d6e6;
      text-decoration: none;
      font-size: 0.86rem;
      font-weight: 600;
      padding: 9px 16px;
      border-radius: 12px;
      background: rgba(15, 15, 20, 0.94);
      border: 1px solid var(--border);
      transition: all 0.18s ease;
    }

    .back-btn:hover {
      color: var(--accent);
      border-color: var(--border-accent);
      transform: translateX(-2px);
    }

    .mini-brand {
      font-size: 1.05rem;
      font-weight: 700;
      line-height: 1.45;
      color: var(--accent);
    }

    .header-card {
      position: relative;
      background: linear-gradient(160deg, rgba(28, 28, 39, 0.95) 0%, rgba(13, 13, 19, 0.99) 100%);
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: clamp(24px, 5vw, 38px);
      margin-bottom: 20px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65);
      overflow: hidden;
    }

    .header-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--accent), transparent);
      opacity: 0.9;
    }

    .song-heading {
      font-size: clamp(1.9rem, 4.5vw, 2.55rem);
      font-weight: 800;
      color: #ffffff;
      line-height: 1.48;
      padding-bottom: 2px;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 12px;
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid var(--border-subtle);
    }

    .info-cell {
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px 14px;
    }

    .info-label {
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 1.1px;
      color: var(--muted);
      font-weight: 700;
      margin-bottom: 4px;
    }

    .info-val {
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--text);
    }

    .folio {
      background: linear-gradient(180deg, rgba(18, 18, 25, 0.96) 0%, rgba(11, 11, 16, 0.99) 100%);
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: clamp(26px, 5vw, 48px);
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7), 0 0 36px var(--accent-glow);
    }

    .folio-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      padding-bottom: 20px;
      margin-bottom: 28px;
      border-bottom: 1px solid var(--border);
    }

    .folio-label {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 1.6px;
      color: var(--accent);
      font-weight: 700;
    }

    .actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .action-btn {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 7px 14px;
      border-radius: 10px;
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.18s ease;
    }

    .action-btn:hover, .action-btn.active {
      color: var(--accent);
      border-color: var(--border-accent);
      background: rgba(246, 178, 68, 0.12);
    }

    #lyrics {
      font-size: 1.24rem;
      line-height: 1.85;
      color: #f2f2fa;
      white-space: normal;
      padding-left: 22px;
      border-left: 2px solid rgba(246, 178, 68, 0.5);
    }

    #lyrics p {
      padding: 14px 18px;
      margin-bottom: 12px;
      background: rgba(255, 255, 255, 0.015);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
    }

    #lyrics p:last-child {
      margin-bottom: 0;
    }

    #lyrics br {
      content: "";
      display: block;
      margin-top: 6px;
    }

    #lyrics hr {
      border: none;
      border-top: 1px solid var(--border);
      margin: 18px 0;
    }
      </style>
</head>
<body>
  <div class="stage">
    <div class="nav-bar">
      <a href="/" class="back-btn">← All Songs</a>
      <div class="mini-brand">ସ୍ୱର ମୂର୍ଚ୍ଛନା</div>
    </div>

    <section class="header-card">
      <h1 class="song-heading"><%= song.Name || slug %></h1>

      <% const hasMeta = song.Singer || song.Composer || song.Lyricist || song.Movie; %>
      <% if (hasMeta) { %>
        <div class="info-grid">
          <% if (song.Singer) { %>
            <div class="info-cell">
              <div class="info-label">Singer</div>
              <div class="info-val"><%= song.Singer %></div>
            </div>
          <% } %>
          <% if (song.Composer) { %>
            <div class="info-cell">
              <div class="info-label">Composer</div>
              <div class="info-val"><%= song.Composer %></div>
            </div>
          <% } %>
          <% if (song.Lyricist) { %>
            <div class="info-cell">
              <div class="info-label">Lyricist</div>
              <div class="info-val"><%= song.Lyricist %></div>
            </div>
          <% } %>
          <% if (song.Movie) { %>
            <div class="info-cell">
              <div class="info-label">Movie</div>
              <div class="info-val"><%= song.Movie %></div>
            </div>
          <% } %>
        </div>
      <% } %>
    </section>

    <article class="folio">
      <div class="folio-bar">
        <span class="folio-label">Lyrics</span>
        <div class="actions">
          <button class="action-btn" onclick="resize(0.1)">A+</button>
          <button class="action-btn" onclick="resize(-0.1)">A-</button>
          <button class="action-btn" id="copyBtn" onclick="copyText()">Copy</button>
        </div>
      </div>

      <div id="lyrics"><%- lyricsHtml %></div>
    </article>
  </div>

  <script>
    let fontSize = 1.24;

    function resize(delta) {
      fontSize = Math.max(0.95, Math.min(1.9, +(fontSize + delta).toFixed(2)));
      document.getElementById('lyrics').style.fontSize = fontSize + 'rem';
    }

    function copyText() {
      const text = document.getElementById('lyrics').innerText;
      navigator.clipboard.writeText(text);
      const btn = document.getElementById('copyBtn');
      btn.textContent = 'Copied ✓';
      btn.classList.add('active');
      setTimeout(() => {
        btn.textContent = 'Copy';
        btn.classList.remove('active');
      }, 1500);
    }
  </script>
</body>
</html>